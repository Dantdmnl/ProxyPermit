# Replace the two addresses and certificate paths for the installed cluster.
# This listener serves only the machine-to-machine HA endpoints.
server {
    server_tokens off;
    access_log off;
    listen 192.0.2.11:8443 ssl;
    ssl_certificate /etc/proxypermit/ha-tls/cert.pem;
    ssl_certificate_key /etc/proxypermit/ha-tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ~ ^/internal/ha/(enroll|policy)$ {
        allow 192.0.2.12;
        deny all;
        access_log off;
        proxy_pass http://127.0.0.1:8080;
    }

    location / { return 404; }
}
